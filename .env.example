# Supabase Edge Functions - server-only secrets (never expose these to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public website used for checkout success/cancel links
PUBLIC_SITE_URL=https://link-land.netlify.app

# payment-webhook: HMAC SHA-256 secret shared with the provider
# Signature header: x-linkland-signature: sha256=<hex>
# Timestamp header: x-linkland-timestamp: <unix seconds>  (5 minute tolerance)
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# expire-featured: cron secret (send x-cron-secret) or service-role bearer
CRON_SECRET=change-me-to-a-long-random-string

# create-payment: disabled by default. Manual mobile-money stays the primary flow.
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_PROVIDER=waafipay

# WaafiPay (server only)
WAAFI_API_URL=https://api.waafipay.net/asm
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=

# Stripe (server only)
STRIPE_SECRET_KEY=
